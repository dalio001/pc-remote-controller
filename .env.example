# Copy to .env and fill in. .env is gitignored and must never be committed.

# ===== Security =====
# Empty means auth is DISABLED - fine on a trusted LAN, never with ENABLE_TUNNEL=true.
# The server refuses to start if the tunnel is on and this is empty or under 12 chars.
AUTH_PASSWORD=

# ===== Server =====
HOST=0.0.0.0
PORT=8080

# ===== Screen capture =====
FRAME_RATE=20
JPEG_QUALITY=70
SCALE_FACTOR=0.5

# ===== AI chat panel (optional) =====
# Note: AI command execution is still a stub - it replies but does not act.
ENABLE_AI=true
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# ===== Public tunnel (optional) =====
# ENABLE_TUNNEL=true publishes this PC to the internet through ngrok, so the phone
# needs no VPN app - just the https URL. Nothing is port-forwarded.
# Get a free authtoken and a free static domain at https://dashboard.ngrok.com.
# Leave NGROK_DOMAIN empty and the URL changes on every restart.
ENABLE_TUNNEL=false
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
